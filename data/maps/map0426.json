s que conhecemos na Terra.\\| ","params":[]},{"code":20110,"indent":0,"string":"Sim, Arton também tem seres humanos...\\| mas","params":[]},{"code":20110,"indent":0,"string":"também tem muito, muito mais que isso.","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"Arton é também um mundo de heróis ","params":[]},{"code":20110,"indent":0,"string":"aventureiros.\\| Eles estão em toda parte, ","params":[]},{"code":20110,"indent":0,"string":"nos reinos, cidades e vilas.","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"Para cada dez ou doze pessoas normais, há","params":[]},{"code":20110,"indent":0,"string":"pelo menos um ser com habilidades especiais","params":[]},{"code":20110,"indent":0,"string":"de combate ou poderes místicos.","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"O heroísmo é trabalho comum em Arton - seja","params":[]},{"code":20110,"indent":0,"string":"para façanhas menores, como espantar os lobos","params":[]},{"code":20110,"indent":0,"string":"que espreitam uma aldeia, até batalhar contra","params":[]},{"code":20110,"indent":0,"string":"vilões supremos.","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"Existem heróis menores, locais, que protegem ","params":[]},{"code":20110,"indent":0,"string":"suas próprias aldeias, vilarejos e tribos","params":[]},{"code":20110,"indent":0,"string":"bárbaras;\\| e há também os grandes campeões,","params":[]},{"code":20110,"indent":0,"string":"lendas vivas que combatem pelo destino do mundo.","params":[]},{"code":11410,"indent":0,"string":"","params":[5,0]},{"code":11030,"indent":0,"string":"","params":[0,0,0,100,1,1]},{"code":11010,"indent":0,"string":"","params":[7]},{"code":11410,"indent":0,"string":"","params":[1]},{"code":10810,"indent":0,"string":"","params":[427,7,2,0]},{"code":11020,"indent":0,"strin
false,"switch_b":false,"variable":false,"item":false,"actor":false,"timer":false,"timer2":false},"switch_a_id":1,"switch_b_id":1,"variable_id":1,"variable_value":0,"item_id":1,"actor_id":1,"timer_sec":0,"timer2_sec":0,"compare_operator":1},"character_name":"Holy Avenger 6","character_index":3,"character_direction":3,"character_pattern":1,"translucent":false,"move_type":0,"move_frequency":3,"trigger":0,"layer":1,"overlap_forbidden":false,"animation_type":0,"move_speed":3,"move_route":{"move_commands":[],"repeat":true,"skippable":false},"event_commands":[]}}},"8":{"name":"Luigi","x":5,"y":6,"pages":{"1":{"condition":{"flags":{"switch_a":false,"switch_b":false,"variable":false,"item":false,"actor":false,"timer":false,"timer2":false},"switch_a_id":1,"switch_b_id":1,"variable_id":1,"variable_value":0,"item_id":1,"actor_id":1,"timer_sec":0,"timer2_sec":0,"compare_operator":1},"character_name":"Holy Avenger 4","character_index":3,"character_direction":1,"character_pattern":1,"translucent":true,"move_type":0,"move_frequency":3,"trigger":3,"layer":1,"overlap_forbidden":false,"animation_type":0,"move_speed":3,"move_route":{"move_commands":[],"repeat":true,"skippable":false},"event_commands":[{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10130,"indent":0,"string":"","params":[0,0,0]},{"code":10120,"indent":0,"string":"","params":[0,2,1,0]},{"code":10110,"indent":0,"string":"\"O mundo nasceu!\\| Nascido, ele foi","params":[]},{"code":20110,"indent":0,"string":" povoado pelos deuses com todo","params":[]},{"code":20110,"indent":0,"string":" tipo de vida!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Valkaria trouxe os humanos...\\|","params":[]},{"code":20110,"indent":0,"string":" Glórienn, os elfos...\\|","params":[]},{"code":20110,"indent":0,"string":" Tenebra, os anões...\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Pensamos nas deusas femininas como as mães de ","params":[]},{"code":20110,"indent":0,"string":" toda a vida, e muitas vezes esquecemos que","params":[]},{"code":20110,"indent":0,"string":" existe também um pai!\\| O soberano do reino","params":[]},{"code":20110,"indent":0,"string":" mais vasto de todos!\\| Grande Oceano!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Como os demais deuses, Oceano também tem sua","params":[]},{"code":20110,"indent":0,"string":" raça eleita!\\| Um povo mais antigo que os elfos!\\|","params":[]},{"code":20110,"indent":0,"string":" Talvez até mais antiga que os dragões!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Mesmo sem fogo para afastar feras e forjar","params":[]},{"code":20110,"indent":0,"string":" metais, eles são a espécie dominante sob","params":[]},{"code":20110,"indent":0,"string":" as ondas!\\| Os elfos-do-mar!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Cada um destes elfos recebe do Grande Oceano","params":[]},{"code":20110,"indent":0,"string":" um dom único...\\| A capacidade de se transformar","params":[]},{"code":20110,"indent":0,"string":" em uma criatura marinha!\\| Quase todos são","params":[]},{"code":20110,"indent":0,"string":" lontras ou golfinhos!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"O tipo de criatura depende do que existe no","params":[]},{"code":20110,"indent":0,"string":" coração de cada um!\\| Por isso, quando os elfos","params":[]},{"code":20110,"indent":0,"string":" conheceram a forma animal de seu príncipe","params":[]},{"code":20110,"indent":0,"string":" Deenar, perceberam como sua alma era podre!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Deenar era inteligente, ambicioso e, acima de ","params":[]},{"code":20110,"indent":0,"string":" tudo, cruel!\\| Acreditava que o destino de seu","params":[]},{"code":20110,"indent":0,"string":" povo era conquistar as terras emersas!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Ele cobiçava os tesouros do mundo seco!\\|","params":[]},{"code":20110,"indent":0,"string":" Especialmente armas metálicas!\\| Assim, antes","params":[]},{"code":20110,"indent":0,"string":" mesmo de ocupar seu lugar de direito no trono,","params":[]},{"code":20110,"indent":0,"string":" ele comandava ataques contra vilas costeiras!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Com armas de aço roubadas, o poder de suas","params":[]},{"code":20110,"indent":0,"string":" tropas crescia!\\| Em busca de armas melhores,","params":[]},{"code":20110,"indent":0,"string":" ele passou a visar fortificações!\\| Uma pequena","params":[]},{"code":20110,"indent":0,"string":" torre foi escolhida como seu primeiro alvo!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Surpresos e aterrorizados, os soldados não","params":[]},{"code":20110,"indent":0,"string":" foram adversários à altura!\\| A vitória parecia","params":[]},{"code":20110,"indent":0,"string":" fácil para Deenar!\\| Com tantas armas, nada","params":[]},{"code":20110,"indent":0,"string":" poderia deter seu avanço sobre o mundo seco!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Pelo menos, assim parecia!\\|","params":[]},{"code":20110,"indent":0,"string":" Mas algo deu errado!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"A história é confusa neste ponto!\\| Ninguém","params":[]},{"code":20110,"indent":0,"string":" sabe o que teria causado a derrota de Deenar","params":[]},{"code":20110,"indent":0,"string":" na torre!\\| Os sobreviventes evitavam apontar","params":[]},{"code":20110,"indent":0,"string":" um responsável!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Quase como se quisessem esconder alguém...\\|","params":[]},{"code":20110,"indent":0,"string":" ou proteger esse alguém!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Se algum herói secreto salvou os soldados","params":[]},{"code":20110,"indent":0,"string":" daquela torre...\\| Apenas os deuses conhecem","params":[]},{"code":20110,"indent":0,"string":" a resposta!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"De qualquer forma, Deenar retornou para seu","params":[]},{"code":20110,"indent":0,"string":" reino em desgraça!\\| Quando soube a respeito","params":[]},{"code":20110,"indent":0,"string":" dos saques, seu pai o rejeitou como filho!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Exilado, Deenar vagou pelos mares em busca","params":[]},{"code":20110,"indent":0,"string":" de poder!\\| Poder para conquistar o mundo","params":[]},{"code":20110,"indent":0,"string":" seco, e para se vingar do povo que traiu","params":[]},{"code":20110,"indent":0,"string":" seu príncipe herdeiro!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Mutilado e sem suas tropas, ele recorreu a","params":[]},{"code":20110,"indent":0,"string":" outro tipo de poder!\\| Magia Negra!\\| Durante os","params":[]},{"code":20110,"indent":0,"string":" anos seguintes ele buscou segredos proibidos!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Violou templos, túmulos e locais de naufrágio,","params":[]},{"code":20110,"indent":0,"string":" aprendendo cada vez mais sobre a invocação de","params":[]},{"code":20110,"indent":0,"string":" horrores ancestrais!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"\"Um dia ele descobriu a caverna onde dormia","params":[]},{"code":20110,"indent":0,"string":" Helena, a enguia-rainha!\\| Sabendo que despertá-la","params":[]},{"code":20110,"indent":0,"string":" poderia custar sua vida, ele tem usado iscas e","params":[]},{"code":20110,"indent":0,"string":" disfarces, para motivar outra pessoa a fazê-lo!\"","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":11030,"indent":0,"string":"","params":[100,100,100,100,20,1]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10130,"indent":0,"string":"Holy Avenger 3","params":[13,0,0]},{"code":10110,"indent":0,"string":"O plano de Deenar pode ser louco,","params":[]},{"code":20110,"indent":0,"string":"mas também é possível!\\| De fato,","params":[]},{"code":20110,"indent":0,"string":"poderia estar sendo realizado agora!","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":11210,"indent":0,"string":"","params":[207,6,1,0]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10130,"indent":0,"string":"Holy Avenger 2","params":[14,0,0]},{"code":10110,"indent":0,"string":"Isso tudo é muito interessante, Luigi!\\|","params":[]},{"code":20110,"indent":0,"string":"É certo que aprecio estudar todas as","params":[]},{"code":20110,"indent":0,"string":"formas de vida e não-vida...","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"... e os elfos-do-mar parecem um","params":[]},{"code":20110,"indent":0,"string":"fascinante objeto de pesquisa!\\| Mas ","params":[]},{"code":20110,"indent":0,"string":"por que, em nome de Wynna e Tenebra, ","params":[]},{"code":20110,"indent":0,"string":"está me contando tal história?","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"Pedi apenas para verificar se minha ","params":[]},{"code":20110,"indent":0,"string":"filha está passando bem!\\| Que ligação","params":[]},{"code":20110,"indent":0,"string":"esse elfo renegado poderia ter ","params":[]},{"code":20110,"indent":0,"string":"com ela?","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10130,"indent":0,"string":"Holy Avenger 3","params":[13,0,0]},{"code":10110,"indent":0,"string":"Talvez nenhuma!\\| Talvez muitas!\\| Você ","params":[]},{"code":20110,"indent":0,"string":"é um necromante, Vlad!","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":10110,"indent":0,"string":"Então deve saber que, assim como os ","params":[]},{"code":20110,"indent":0,"string":"ossos de um esqueleto, as pessoas","params":[]},{"code":20110,"indent":0,"string":"também estão conectadas neste grande","params":[]},{"code":20110,"indent":0,"string":"organismo que chamamos mundo!","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":11210,"indent":0,"string":"","params":[204,8,1,0]},{"code":10210,"indent":0,"string":"","params":[0,248,248,0]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":11330,"indent":0,"string":"","params":[6,8,0,0],"route":[{"code":14}]},{"code":10130,"indent":0,"string":"Holy Avenger 2","params":[14,0,0]},{"code":10110,"indent":0,"string":"Tarso, prepare minha bagagem!","params":[]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":11520,"indent":0,"string":"","params":[5000]},{"code":11030,"indent":0,"string":"","params":[0,0,0,100,20,1]},{"code":10810,"indent":0,"string":"","params":[430,8,2,0]},{"code":11410,"indent":0,"string":"","params":[10,0]},{"code":11030,"indent":0,"string":"","params":[30,30,100,100,20,1]}]},"2":{"condition":{"flags":{"switch_a":true,"switch_b":false,"variable":false,"item":false,"actor":false,"timer":false,"timer2":false},"switch_a_id":248,"switch_b_id":1,"variable_id":1,"variable_value":0,"item_id":1,"actor_id":1,"timer_sec":0,"timer2_